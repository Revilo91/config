{%- macro set_cover_position(position) -%}
  - service: cover.set_cover_position
    data:
      position: "{{ position }}"
    target:
      entity_id: !input rollladen
{%- endmacro -%}

# Definiere eine Macro-Funktion für das Öffnen des Rollladens
{%- macro open_cover() -%}
  - service: cover.open_cover
    target:
      entity_id: !input rollladen
{%- endmacro -%}


{%- macro close_cover() -%}
  - service: cover.close_cover
    target:
      entity_id: !input rollladen
{%- endmacro -%}


